# RUN: llc -mtriple=x86_64-unknown-linux-gnu \
# RUN: --load=%llvmshlibdir/gonozov_l_lab_3_BACKEND%shlibext \
# RUN: -run-pass=example-x86-inline %s -o - | FileCheck %s

# CHECK-LABEL: name: recfun
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: CALL64pcrel32
# CHECK: RET64

---
name: recfun
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    CALL64pcrel32 @recfun
    RET64

# SIZE-LABEL: name: caller
# SIZE: CALL64pcrel32 @bigfun
# SIZE: RET64

---
name: bigfun
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
    %15:gr32 = MOV32ri 15
    RET64

---
name: caller
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @bigfun
    RET64

# INLINE-LABEL: name: caller2
# INLINE: ADD32ri
# INLINE-NOT: CALL64pcrel32 @smallfun
# INLINE: RET64

---
name: smallfun
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = ADD32ri %0, 5, implicit-def $eflags
    $eax = COPY %1
    RET64

---
name: caller2
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    CALL64pcrel32 @smallfun
    RET64
